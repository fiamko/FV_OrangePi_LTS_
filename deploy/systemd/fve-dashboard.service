[Unit]
Description=FVE Flask dashboard + MQTT worker (INA226, controller, history)
Documentation=https://github.com/pedude/FV_elektrarna
After=network-online.target mosquitto.service fve-menic-reader.service
Wants=network-online.target fve-menic-reader.service
Requires=mosquitto.service

[Service]
Type=simple
User=fiam
Group=fiam
WorkingDirectory=/home/fiam/menic_web
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/fiam/menic_web/fve-env/bin/python /home/fiam/menic_web/app01.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
